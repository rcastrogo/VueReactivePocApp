{
  "name": "vue-reactive-poc-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel css:watch server",
    "dev-ui": "npm-run-all --parallel css:watch serve",
    "server": "node --env-file=.env --watch server.js",
    "start": "node server.js",
    "serve": "browser-sync start --server public --files public/**/*.html,public/css/**/*.css,public/js/**/*.js --port 3000 --no-open --reload-debounce 200",
    "css:watch": "npx @tailwindcss/cli -i ./public/css/app.css -o ./public/css/tailwind.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./public/css/app.css -o ./public/css/tailwind.css --minify",
    "codegen": "node ./scripts/code.cjs",
    "codegen:example": "node ./scripts/code.cjs -i ./scripts/examples/usuario.json -o ./src/code"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@vercel/node": "^5.9.5",
    "browser-sync": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.6"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "express": "^5.2.1"
  }
}
